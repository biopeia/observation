{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blocks/**",
              "components/core/**",
              "components/document/**",
              "components/navigation/**",
              "ui_kits/docs/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Serif 4|Schibsted Grotesk|Martian Mono))/i]",
        "message": "Font not provided by the design system. Available: Source Serif 4, Schibsted Grotesk, Martian Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onSelect|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|onClick|type|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, onClick, type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|id|status|strength|scope|source|supersededBy|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: kind, title, id, status, strength, scope, source, supersededBy, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|language|title|caption|tone|lineNumbers|highlight|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, language, title, caption, tone, lineNumbers, highlight."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<CodeBlock> tone must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|mono|width|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, mono, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|status|statusDetail|key|ref|className|style|children)$/]",
        "message": "<DecisionItem> doesn't accept that prop. Declared props: title, body, status, statusDetail."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:docType|id|title|subtitle|abstract|domains|status|meta|supersededBy|key|ref|className|style|children)$/]",
        "message": "<DocHeader> doesn't accept that prop. Declared props: docType, id, title, subtitle, abstract, domains, status, meta, supersededBy."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|number|status|key|ref|className|style|children)$/]",
        "message": "<DocNavItem> doesn't accept that prop. Declared props: id, label, number, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='DomainTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:domain|variant|children|title|key|ref|className|style|children)$/]",
        "message": "<DomainTag> doesn't accept that prop. Declared props: domain, variant, children, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='DomainTag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:label|filled|glyph)$/]",
        "message": "<DomainTag> variant must be one of 'label' | 'filled' | 'glyph'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|label|scope|compact|key|ref|className|style|children)$/]",
        "message": "<EvidenceMeter> doesn't accept that prop. Declared props: level, label, scope, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|caption|source|tone|height|wide|children|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: number, caption, source, tone, height, wide, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<Figure> tone must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineageItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|relation|status|date|key|ref|className|style|children)$/]",
        "message": "<LineageItem> doesn't accept that prop. Declared props: id, title, relation, status, date."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|shortcut|width|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, shortcut, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|level|id|kicker|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: number, title, level, id, kicker."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:path|kind|note|href|key|ref|className|style|children)$/]",
        "message": "<SourceItem> doesn't accept that prop. Declared props: path, kind, note, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:design|code|test|adr|study|doc|config)$/]",
        "message": "<SourceItem> kind must be one of 'design' | 'code' | 'test' | 'adr' | 'study' | 'doc' | 'config'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|detail|size|key|ref|className|style|children)$/]",
        "message": "<StatusMark> doesn't accept that prop. Declared props: status, label, detail, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<StatusMark> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toc'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|activeId|title|onSelect|key|ref|className|style|children)$/]",
        "message": "<Toc> doesn't accept that prop. Declared props: items, activeId, title, onSelect."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
